{
  "name": "saifen-security",
  "version": "1.0.0",
  "private": true,
  "description": "Site estático SAIFEN SECURITY — presença invisível (Tailwind v4 + HTML estático)",
  "scripts": {
    "build": "tailwindcss -i src/input.css -o assets/styles-B71o8YZb.css --minify",
    "watch": "tailwindcss -i src/input.css -o assets/styles-B71o8YZb.css --watch",
    "dev": "tailwindcss -i src/input.css -o assets/styles-B71o8YZb.css --watch --poll & node server.mjs",
    "start": "node server.mjs",
    "start:local": "HOST=127.0.0.1 node server.mjs",
    "start:porta": "PORT=8080 node server.mjs"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.14",
    "tailwindcss": "^4.1.14"
  }
}
